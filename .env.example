# Interfaces publicadas pelo Docker. Mantenha 127.0.0.1 e use VPN/SSH/reverse proxy
# para acesso remoto. Nunca use 0.0.0.0 sem TLS e uma camada adicional de acesso.
BIND_ADDRESS=127.0.0.1
NOVNC_PORT=6080
VNC_PORT=5900

# A senha VNC clássica aceita no máximo 8 caracteres. Use uma senha única e uma
# camada adicional (VPN, SSH ou proxy HTTPS autenticado) se o acesso for remoto.
VNC_PASSWORD=troque12

# native: carrega ./script.js automaticamente pela extensão MV3 local.
# tampermonkey: inicia o Tampermonkey completo e permite importar o script pelo painel.
# none: inicia só o navegador.
SCRIPT_MODE=native

SCREEN_RESOLUTION=1366x768
TZ=America/Sao_Paulo
